{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "meai-creator",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "meaiplatform.io.vn",
      "custom_domain": true
    }
  ],

  "vars": {
    "VITE_API_URL": "https://api.example.com",
    "VITE_STRIPE_PUBLISHABLE_KEY": "pk_test_example",
    "VITE_GOOGLE_CLIENT_ID": "example.apps.googleusercontent.com",
    "SESSION_SECRET": "replace-with-cloudflare-worker-secret",
    "SESSION_EXPIRES_IN_DAYS": "365"
  },

  "assets": {
    "directory": "./build/client"
  },

  "placement": {
    "mode": "smart"
  },

  "observability": {
    "enabled": true
  }
}
